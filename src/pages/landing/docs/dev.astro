---
/**
 * Development Manual index (/landing/docs/dev, English).
 */
import { getCollection } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import HandbookManualList from '~/components/landing/HandbookManualList.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import { chaptersForLocale } from '~/lib/handbook';

const t = landingContent.en;
const chapters = chaptersForLocale(await getCollection('handbook'), 'en');

const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/docs/dev` },
];
---

<LandingLayout
  locale="en"
  alternates={alternates}
  pageTitle={`${t.handbook.manuals.dev.label} | AnvilWiki Docs`}
  pageDescription={t.handbook.manuals.dev.description}
>
  <HandbookManualList manual="dev" chapters={chapters} locale="en" t={t} />
</LandingLayout>
