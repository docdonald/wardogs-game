---
/**
 * Published content index — a cross-category directory for the English wiki.
 * The cards are derived from the content collection so the index cannot drift
 * from the pages that are actually published.
 */
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { siteUrl } from '~/config/site';
import { defaultLocale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getEntriesByCategory, parseEntryId } from '~/lib/content';
import { detailPath, homeUrl, languageAlternates, localizePath } from '~/lib/url';
import { pageTitle, simpleBreadcrumbJsonLd, urlListJsonLd } from '~/lib/seo';

const locale = defaultLocale;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared as unknown as Record<string, string>;
const overview = ui.overview as Record<
  string,
  { overviewTitle: string; overviewDescription: string }
>;

const categories = (
  await Promise.all(
    NAVIGATION_CONFIG.map(async (item) => ({
      item,
      entries: await getEntriesByCategory(item.key, locale),
    })),
  )
).filter(({ entries }) => entries.length > 0);

const allEntries = categories.flatMap(({ entries }) => entries);
const jsonLd = [
  simpleBreadcrumbJsonLd({
    pageLabel: shared.wikiIndexTitle,
    path: localizePath('/wiki', locale),
    locale,
    homeLabel: nav.home,
  }),
  urlListJsonLd({
    name: shared.wikiIndexTitle,
    items: allEntries.flatMap((entry) => {
      const parsed = parseEntryId(entry.id);
      return parsed
        ? [
            {
              title: entry.data.title,
              url: `${siteUrl}${detailPath(parsed.category, parsed.slug, locale)}`,
            },
          ]
        : [];
    }),
  }),
];
const alternates = languageAlternates(() => localizePath('/wiki', locale), [locale]);
---

<LocaleLayout
  locale={locale}
  title={pageTitle(shared.wikiIndexTitle)}
  description={shared.wikiIndexDescription}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="space-y-8" data-pagefind-body>
    <header>
      <nav class="text-sm text-muted-foreground" aria-label={shared.breadcrumbAria ?? 'Breadcrumb'}>
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">{shared.wikiIndexTitle}</span>
      </nav>
      <div class="mt-3 flex items-center gap-3">
        <Icon name="lucide:list" class="h-7 w-7 text-nav" aria-hidden="true" />
        <h1 class="display-title text-3xl md:text-4xl">{shared.wikiIndexTitle}</h1>
      </div>
      <p class="mt-3 max-w-3xl text-muted-foreground">{shared.wikiIndexDescription}</p>
    </header>

    <div class="space-y-10">
      {
        categories.map(({ item, entries }) => (
          <section aria-labelledby={`wiki-index-${item.key}`}>
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
              <div>
                <h2 id={`wiki-index-${item.key}`} class="display-title text-2xl">
                  {overview[item.key]?.overviewTitle ?? nav[item.key] ?? item.key}
                </h2>
                <p class="mt-1 text-sm text-muted-foreground">
                  {overview[item.key]?.overviewDescription}
                </p>
              </div>
              <span class="text-xs uppercase tracking-wider text-muted-foreground">
                {entries.length} {shared.wikiIndexPages}
              </span>
            </div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {entries.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card block p-4">
                    <h3 class="font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                    <span class="mt-3 inline-flex text-xs font-medium text-nav">
                      {shared.wikiIndexBrowse}
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</LocaleLayout>
