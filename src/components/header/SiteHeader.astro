---
/**
 * Site header — logo and primary nav.
 * Mobile menu uses native <details> (zero JS).
 */
import { Icon } from 'astro-icon/components';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { localizePath } from '~/lib/url';
import { landingLinkEnabled } from '~/config/project';

interface Props {
  locale: Locale;
  currentPath: string;
}
const { locale, currentPath } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav as unknown as Record<string, any>;
const accessLinks = Array.isArray(nav.accessLinks) ? nav.accessLinks : [];
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4">
    {/* Logo */}
    <a
      href={localizePath('/', locale)}
      class="flex items-center gap-2 font-bold text-foreground"
      aria-label={site.name}
    >
      <img
        src="/favicon_io/android-chrome-192x192.png"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 rounded-md object-contain"
        aria-hidden="true"
      />
      <span class="hidden sm:inline">{site.shortName}</span>
    </a>

    {/* Desktop nav */}
    <nav class="hidden flex-1 items-center gap-1 md:flex">
      <a
        href={localizePath('/wiki', locale)}
        class:list={[
          'rounded-md px-3 py-1.5 text-sm font-medium transition',
          currentPath === localizePath('/wiki', locale)
            ? 'bg-muted text-nav'
            : 'text-foreground/70 hover:bg-muted hover:text-foreground',
        ]}
      >
        {nav.index ?? 'Wiki Index'}
      </a>
      {
        accessLinks.length > 0 && (
          <details class="group relative">
            <summary
              class:list={[
                'cursor-pointer list-none rounded-md px-3 py-1.5 text-sm font-medium transition',
                accessLinks.some((link: { href: string }) => currentPath === localizePath(link.href, locale))
                  ? 'bg-muted text-nav'
                  : 'text-foreground/70 hover:bg-muted hover:text-foreground',
              ]}
            >
              {nav.access ?? 'Access'}
            </summary>
            <div class="absolute left-0 top-full z-50 mt-2 min-w-56 border border-border bg-card p-1 shadow-lg">
              <p class="px-3 py-2 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                {nav.accessMenu ?? nav.access ?? 'Access guides'}
              </p>
              {accessLinks.map((link: { label: string; href: string }) => (
                <a
                  href={localizePath(link.href, locale)}
                  class="block px-3 py-2 text-sm text-foreground transition hover:bg-muted hover:text-nav"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </details>
        )
      }
      {
        NAVIGATION_CONFIG.map((item) => {
          const path = localizePath(item.path, locale);
          const isActive = currentPath === path || currentPath.startsWith(path + '/');
          return (
            <a
              href={path}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm font-medium transition',
                isActive
                  ? 'bg-muted text-nav'
                  : 'text-foreground/70 hover:bg-muted hover:text-foreground',
              ]}
            >
              {nav[item.key] ?? item.key}
            </a>
          );
        })
      }
    </nav>

    {/* Right actions */}
    <div class="ml-auto flex items-center gap-1">
      {
        landingLinkEnabled && (
          <a
            href="/landing"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-nav"
            aria-label="About the AnvilWiki template"
            title="About the AnvilWiki template"
          >
            <Icon name="lucide:hammer" class="h-5 w-5" />
          </a>
        )
      }
      {/* Mobile menu */}
      <details class="relative md:hidden">
        <summary
          class="inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-foreground transition hover:bg-muted"
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </summary>
        <div class="absolute right-0 mt-2 w-56 overflow-hidden rounded-md border bg-card shadow-lg">
          <a
            href={localizePath('/wiki', locale)}
            class="block px-3 py-2 text-sm transition hover:bg-muted"
          >
            {nav.index ?? 'Wiki Index'}
          </a>
          {
            accessLinks.length > 0 && (
              <details class="border-t border-border">
                <summary class="cursor-pointer list-none px-3 py-2 text-sm font-semibold text-nav">
                  {nav.access ?? 'Access'}
                </summary>
                <div class="pb-1">
                  {accessLinks.map((link: { label: string; href: string }) => (
                    <a
                      href={localizePath(link.href, locale)}
                      class="block px-5 py-2 text-sm transition hover:bg-muted hover:text-nav"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </details>
            )
          }
          {
            NAVIGATION_CONFIG.map((item) => (
              <a
                href={localizePath(item.path, locale)}
                class="block px-3 py-2 text-sm transition hover:bg-muted"
              >
                {nav[item.key] ?? item.key}
              </a>
            ))
          }
          {
            landingLinkEnabled && (
              <a
                href="/landing"
                class="mt-1 flex items-center gap-2 border-t border-border px-3 py-2 text-sm text-muted-foreground transition hover:bg-muted hover:text-nav"
              >
                <Icon name="lucide:hammer" class="h-4 w-4" />
                <span>AnvilWiki Template</span>
              </a>
            )
          }
        </div>
      </details>
    </div>
  </div>
</header>
